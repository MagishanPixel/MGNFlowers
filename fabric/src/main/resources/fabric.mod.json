{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",

  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "${mod_author}"
  ],
  "license": "${license}",
  "icon": "${mod_id}.png",

  "environment": "*",
  "entrypoints": {
    "main": [
      "io.github.magishanpixel.mgnflowers.fabric.MGNFlowers_FABRIC"
    ],
    "client": [
      "io.github.magishanpixel.mgnflowers.fabric.client.MGNFlowersClient_FABRIC"
    ],
    "fabric-datagen": [
      "io.github.magishanpixel.mgnflowers.fabric.datagen.MGNFlowersDataGen"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json",
    "${mod_id}.fabric.mixins.json"
  ],
  "depends": {
    "java": ">=${java_version}",
    "minecraft": ">=${minimum_minecraft_version}",
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_version}",
    "balm": ">=${minimum_balm_version}"
  },
  "suggests": {
  }
}
