{
  "multipart": [
    {
      "apply": {
        "model": "mgnflowers:block/taller_flower/single/glowing_tall_tulip/bottom"
      },
      "when": {
        "stem": "0"
      }
    },
    {
      "apply": {
        "model": "mgnflowers:block/taller_flower/single/glowing_tall_tulip/bottom"
      },
      "when": {
        "stem": "1"
      }
    },
    {
      "apply": {
        "model": "mgnflowers:block/taller_flower/single/glowing_tall_tulip/middle"
      },
      "when": {
        "stem": "2"
      }
    },
    {
      "apply": {
        "model": "mgnflowers:block/taller_flower/single/glowing_tall_tulip/top"
      },
      "when": {
        "stem": "3"
      }
    }
  ]
